# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TTS_PROVIDER: Primary Text-to-Speech provider ('elevenlabs' or 'google'). Defaults to 'elevenlabs'.
TTS_PROVIDER="elevenlabs"

# ELEVENLABS_API_KEY: Optional ElevenLabs API key for Multilingual v2 neural voice synthesis.
# Configure via Secrets / Environment Variables; server-side only (never exposed to browser).
ELEVENLABS_API_KEY=""

# STABILITY_API_KEY: Optional Stability AI key for Stable Audio (Music/SFX) and Stable Image Core.
# Configure via Secrets / Environment Variables; server-side only. Falls back to built-in studio engine if unset.
STABILITY_API_KEY=""

# OPENAI_API_KEY: Optional OpenAI API key for GPT-Image-1 in AI Image Studio (server-side only).
OPENAI_API_KEY=""

# BFL_API_KEY: Optional Black Forest Labs API key for FLUX image models in AI Image Studio (server-side only).
BFL_API_KEY=""

# GOOGLE_TTS_API_KEY: Optional Google Cloud Text-to-Speech API key for studio neural MP3 synthesis
# (Kannada kn-IN, English en-US, Hindi hi-IN, Tamil ta-IN, Telugu te-IN).
GOOGLE_TTS_API_KEY=""

# Social Media Studio OAuth 2.0 Credentials (Optional - Studio Sandbox mode works without secrets)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
META_APP_ID=""
META_APP_SECRET=""
# Use a stable random secret of at least 32 characters in production.
SOCIAL_TOKEN_SECRET=""

# Google Blogger API v3 OAuth 2.0 Credentials (Optional - can share Google Cloud client or use Sandbox mode)
GOOGLE_BLOGGER_CLIENT_ID=""
GOOGLE_BLOGGER_CLIENT_SECRET=""

# Razorpay Payment Gateway Credentials (Optional - Built-in Verified Test Mode works without keys)
# Set these once your Razorpay account KYC is verified to enable Live UPI / Card / Netbanking Checkout
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# IconScout API v3 Credentials (Server-side proxy for Icons, 3D, Illustrations & Lottie search/download)
ICONSCOUT_CLIENT_ID=""
ICONSCOUT_CLIENT_SECRET=""
