+        }
+        case 'ocean-loop': {
+          const crest = .46 + .021 * sin(x * 19 + t * tau);
+          const wave = sin(y * 85 + x * 8 + t * tau);
+          rgb = y < crest ? [48 + y * 78, 129 + y * 63, 181] : [14, 94 + wave * 23, 153 + wave * 30]; a = 1; break;
