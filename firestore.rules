rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isAdminList() {
      return isVerifiedUser() && request.auth.token.email == 'zkm.information@gmail.com';
    }

    function isAdmin() {
      return isAdminList() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidPlan(plan) {
      return plan is string && plan.size() >= 1 && plan.size() <= 64;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'role', 'plan',
          'creditsRemaining', 'creditsUsedThisMonth', 'storageUsedMb',
          'projectsCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'role', 'plan',
          'creditsRemaining', 'creditsUsedThisMonth', 'storageUsedMb',
          'projectsCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.role in ['user', 'admin']
        && isValidPlan(data.plan)
        && data.creditsRemaining is number && data.creditsRemaining >= 0 && data.creditsRemaining <= 5000000
        && data.creditsUsedThisMonth is number && data.creditsUsedThisMonth >= 0 && data.creditsUsedThisMonth <= 5000000
        && data.storageUsedMb is number && data.storageUsedMb >= 0 && data.storageUsedMb <= 1000000
        && data.projectsCount is number && data.projectsCount >= 0 && data.projectsCount <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProject(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'genre', 'status',
          'aspectRatio', 'resolution', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'genre', 'status',
          'aspectRatio', 'resolution', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.genre is string && data.genre.size() >= 1 && data.genre.size() <= 80
        && data.status in ['Development', 'Pre-Production', 'Production', 'Post-Production', 'Completed']
        && data.aspectRatio is string && data.aspectRatio.size() >= 1 && data.aspectRatio.size() <= 16
        && data.resolution is string && data.resolution.size() >= 1 && data.resolution.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLibraryAsset(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'category', 'format',
          'duration', 'size', 'url', 'thumbnail', 'provider',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'name', 'category', 'format',
          'duration', 'size', 'url', 'thumbnail', 'provider',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 180
        && data.category in ['footage', 'audio', 'sfx', 'stills', 'vfx']
        && data.format is string && data.format.size() >= 1 && data.format.size() <= 40
        && data.duration is string && data.duration.size() >= 1 && data.duration.size() <= 32
        && data.size is string && data.size.size() >= 1 && data.size.size() <= 32
        && data.url is string && data.url.size() <= 1000
        && data.thumbnail is string && data.thumbnail.size() <= 1000
        && data.provider is string && data.provider.size() >= 1 && data.provider.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUsageLog(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'tool', 'provider', 'creditsUsed', 'summary', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'tool', 'provider', 'creditsUsed', 'summary', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.tool is string && data.tool.size() >= 1 && data.tool.size() <= 80
        && data.provider is string && data.provider.size() >= 1 && data.provider.size() <= 80
        && data.creditsUsed is number && data.creditsUsed >= 0 && data.creditsUsed <= 1000000
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 240
        && data.createdAt is timestamp;
    }

    // Bootstrapped admin marker collection (read-only from client)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner(adminId);
      allow list, write: if false;
    }

    // User Profiles & Subscriptions (PII isolated to owner or verified admin; no exists() in list)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdminList();

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == userId
        && (incoming().role == 'user' || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isSignedIn()
        && isValidUserAccount(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'plan', 'creditsRemaining', 'creditsUsedThisMonth', 'storageUsedMb', 'projectsCount', 'displayName', 'updatedAt'])) ||
          (isOwner(userId)
            && incoming().role == existing().role
            && incoming().email == existing().email
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'plan', 'creditsRemaining', 'creditsUsedThisMonth', 'storageUsedMb', 'projectsCount', 'updatedAt']))
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // User Projects
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (isAdmin() || (isVerifiedUser() && existing().ownerId == request.auth.uid));
      allow list: if isAdminList() || (isVerifiedUser() && resource.data.ownerId == request.auth.uid);

      allow create: if isValidId(projectId)
        && isVerifiedUser()
        && isValidProject(incoming())
        && incoming().id == projectId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(projectId)
        && isVerifiedUser()
        && isValidProject(incoming())
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || existing().ownerId == request.auth.uid)
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'genre', 'status', 'aspectRatio', 'resolution', 'updatedAt']);

      allow delete: if isValidId(projectId) && (isAdmin() || (isVerifiedUser() && existing().ownerId == request.auth.uid));
    }

    // My Library Assets
    match /library_assets/{assetId} {
      allow get: if isValidId(assetId) && (isAdmin() || (isVerifiedUser() && existing().ownerId == request.auth.uid));
      allow list: if isAdminList() || (isVerifiedUser() && resource.data.ownerId == request.auth.uid);

      allow create: if isValidId(assetId)
        && isVerifiedUser()
        && isValidLibraryAsset(incoming())
        && incoming().id == assetId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(assetId)
        && isVerifiedUser()
        && isValidLibraryAsset(incoming())
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || existing().ownerId == request.auth.uid)
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'format', 'duration', 'size', 'url', 'thumbnail', 'provider', 'updatedAt']);

      allow delete: if isValidId(assetId) && (isAdmin() || (isVerifiedUser() && existing().ownerId == request.auth.uid));
    }

    // Usage Activity Logs (append-only)
    match /usage_logs/{logId} {
      allow get: if isValidId(logId) && (isAdmin() || (isVerifiedUser() && existing().ownerId == request.auth.uid));
      allow list: if isAdminList() || (isVerifiedUser() && resource.data.ownerId == request.auth.uid);

      allow create: if isValidId(logId)
        && isVerifiedUser()
        && isValidUsageLog(incoming())
        && incoming().id == logId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isValidId(logId) && isAdmin();
    }
  }
}
